# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-3.5-turbo

# Qdrant Configuration
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=book-embeddings

# Neon Postgres Configuration
POSTGRES_HOST=your-project.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=rag_chatbot
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SSLMODE=require

# Application Configuration
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_QUERIES_PER_HOUR=50

# RAG Configuration
SIMILARITY_THRESHOLD=0.72
TOP_K_RESULTS=5
CHUNK_SIZE_MIN=500
CHUNK_SIZE_MAX=1000
CHUNK_OVERLAP_PERCENT=25
MAX_CONVERSATION_TURNS=10
MAX_QUERY_LENGTH_TOKENS=1000

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1

# Cost Monitoring
MONTHLY_COST_LIMIT_USD=20.0

# Security (Production)
# Generate a secure random key for production: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=your_secure_admin_api_key_here
